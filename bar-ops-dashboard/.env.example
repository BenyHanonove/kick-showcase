# Copy to .env.local (or .env.<mode>) and fill in. Only VITE_* vars reach the browser bundle.

# HTTP API base URL (in dev, Vite proxies /api to it)
VITE_AWS_URL=https://<HTTP_API_ID>.execute-api.<region>.amazonaws.com
VITE_API_TIMEOUT_MS=15000

# App
VITE_APP_NAME=KICK
VITE_APP_ENV=development
VITE_ENABLE_LOGS=false

# Cognito
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_IDP_URL=https://cognito-idp.<region>.amazonaws.com/

# WebSocket API URL, including the stage path
VITE_WS_URL=wss://<WS_API_ID>.execute-api.<region>.amazonaws.com/<stage>

# Public contact details (landing and legal pages)
VITE_CONTACT_EMAIL=contact@example.com
VITE_CONTACT_WHATSAPP=972500000000
