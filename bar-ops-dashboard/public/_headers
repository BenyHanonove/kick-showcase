# Security Headers for all routes
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.kicks.ltd wss://ws.kicks.ltd https://dn3xyet6gl.execute-api.eu-west-1.amazonaws.com https://cognito-idp.eu-west-1.amazonaws.com wss://q5tfo2tmuk.execute-api.eu-west-1.amazonaws.com wss://fd1rovci2f.execute-api.eu-west-1.amazonaws.com wss://*.execute-api.eu-west-1.amazonaws.com https://*.s3.eu-west-1.amazonaws.com https://*.s3.amazonaws.com https://cloudflareinsights.com; frame-ancestors 'none';

# Assets are content hashed AND live under a per-build folder (vite.config.ts),
# so a URL always names the same bytes and is safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

