# Copy to .env.<stage> (e.g. .env.dev, .env.production). Names only; never commit real values.
# Read by sst.config.ts / infrastructure/ at deploy time and forwarded to the Lambdas that need them.

# --- Cognito: required in production; leave unset on other stages to get a stage-owned pool ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Adopting console-created resources (see architecture/infrastructure-as-code.md) ---
# true = Pulumi `import` of the existing tables/APIs instead of creating new ones
IMPORT_EXISTING=false
# Required when IMPORT_EXISTING=true
HTTP_API_ID=
HTTP_API_AUTHORIZER_ID=
WEBSOCKET_API_ID=
# Optional: JSON of route / integration / event-source-mapping ids to import
IMPORT_IDS_FILE=
HTTP_API_STAGE_NAME=$default
WEBSOCKET_STAGE_NAME=
# false = leave HTTP routes in the console and deploy only invoke permissions
MANAGE_API_ROUTES=true
# Comma-separated; on import it must equal the console CORS config
CORS_ALLOW_ORIGINS=

# --- Observability ---
# SNS email for alarms (optional); ALARMS_ENABLED defaults to on in production only
ALARM_EMAIL=
ALARMS_ENABLED=
POWERTOOLS_LOG_LEVEL=

# --- Storage / email ---
GLOBAL_BUCKET=
SES_FROM_ADDRESS=

# --- Redis (password lives in SSM: /bar-ops-api-v3/<stage>/redis-password) ---
REDIS_HOST=
REDIS_PORT=
# Local runs only; deployed Lambdas read REDIS_PASSWORD_PARAM from SSM instead
REDIS_PASSWORD=

# --- WhatsApp Cloud API (service currently retired) ---
# The access token is NOT an env var: it is an SSM SecureString whose name is passed
# to the Lambdas as WHATSAPP_TOKEN_PARAM (convention: /kick/<stage>/whatsapp-token).
WHATSAPP_TOKEN_PARAM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_COUNTRY_CODE=+972

# --- Integration test suite (packages/testing) ---
# HTTP API base URL of this stage, e.g. https://<HTTP_API_ID>.execute-api.<region>.amazonaws.com
API_BASE_URL=
VITE_COGNITO_CLIENT_ID=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_MANAGER_EMAIL=
TEST_MANAGER_PASSWORD=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Optional: number allow-listed as a WhatsApp test recipient
TEST_WHATSAPP_PHONE=
