{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aws/s3/*": ["packages/shared/aws/s3/*"],
      "@aws/dynamo/*": ["packages/shared/aws/dynamo/*"],
      "@aws/eventbridge/*": ["packages/shared/aws/eventbridge/*"],
      "@aws/lambdas/*": ["packages/shared/aws/lambdas/*"],
      "@aws/redis/*": ["packages/shared/aws/redis/*"],
      "@dtos/*": ["packages/shared/dtos/*"],
      "@env/*": ["packages/shared/env/*"],
      "@guards/*": ["packages/shared/guards/*"],
      "@validation/*": ["packages/shared/validation/*"],
      "@utils/mappers/*": ["packages/shared/utils/mappers/*"],
      "@utils/messages/*": ["packages/shared/utils/messages/*"],
      "@utils/file-generation/*": ["packages/shared/utils/file-generation/*"],
      "@utils/request/*": ["packages/shared/utils/request/*"],
      "@utils/whatsapp/*": ["packages/shared/utils/whatsapp/*"],
      "@utils/*": ["packages/shared/utils/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@functions/*": ["packages/functions/*"]
    }
  },
  "include": [
    "sst.config.ts",
    "sst-env.d.ts",
    "packages/**/*",
    "infrastructure/**/*"
  ],
  "exclude": ["node_modules", ".sst"]
}